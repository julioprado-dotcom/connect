{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist-services",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "worker-service.ts",
    "scheduler-service.ts",
    "engine-route.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src/app/**/*",
    "src/components/**/*",
    "skills",
    "scripts",
    "backups"
  ]
}