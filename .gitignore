# Z.ai Sandbox / Runtime
.zscripts/
worklog*.md
HANDOFF*.md
agent-ctx/

# download/ — ignore everything except productos/
download/*
!download/productos/
download/productos/*
!download/productos/semana-*/

# docs/ — internal documentation, never tracked
docs/
documents/
upload/*.md
upload/*.pdf
upload/*.docx
upload/*.txt

# Root-level documentation (not code)
CONTEXTO.md
SETUP_IA.md
PROTOCOLO_GIT.md
README-SETUP.md
decodex-audit.txt
decodex-docs.txt
node_modules/

# ─── Base de datos (NUNCA trackear) ──────────────────────────
# La BD del VPS es la fuente de verdad. Jamás viaja en git.
# Si custom.db estuviera trackeada, cada git pull/reset
# sobrescribiría la BD del VPS con la del repo, perdiendo datos.
# Los backups automáticos se guardan en prisma/db/backups/ (ignorados).
prisma/db/custom.db
prisma/db/backups/

# Legacy/conflicting databases — DO NOT track
backups/*.db
prisma/dev.db
prisma/db/custom-empty-backup.db
prisma/db/*.bak
prisma/db/custom.db.pre-*
prisma/db/custom.db.sin-*
prisma/db/custom.db.vacio

# Sensitive / session files
agent-ctx/

# Environment (plain text — NEVER commit)
.env
.env.local
upload/.env*
# Encrypted backups ARE tracked (AES-256)
!.env.enc
!.z-ai-config.enc

# Next.js
.next/
out/
next-env.d.ts

# Prisma
prisma/migrations/
.prisma-schema-hash
# prisma/generated-client/ is TRACKED — contains pre-generated Prisma Client for VPS deploy
# (eliminates prisma generate from deploy pipeline)

# Database
db/
*.db-journal
*.db-wal
nohup.out
start-*.sh
server.pid
tmp-query.cjs
connect/

# ZAI SDK config (plain text — never commit this)
.z-ai-config
# Exception: encrypted backups are tracked
!.z-ai-config.enc
!/.z-ai-config.example

# Z.ai skills (managed externally)
skills/

# Build artifacts
tsconfig.tsbuildinfo
package-lock.json

# Temp data files
search*.json
social_search*.json
suplentes_detalle.json

# Scraping / parse scripts (one-off utilities)
parse_*.py
build_final_json.py

# Misc
.DS_Store
*.log
tmp/
CLAUDE.md
AGENTS.md
*.disabled
_scripts_disabled/
scripts/logs/
examples/
decodeX-bolivia/
mini-services/

# Temporary data files from web scraping
data/*.pdf
data/*.xlsx
data/*_electos.json
data/*_search*.json
data/diputados_*.json
data/unitel_*.json
data/oep_*.json
data/elpais_*.json
data/erbol_*.json
data/boliviaverifica_*.json
data/electos_*.json
data/electos_2025_text.txt

# Heavy files to never track
backups/archives/
logs/
tool-results/

# Generated Prisma client
prisma/generated-client/

# Build outputs
dist-services/
Build/

# Temp scripts
*.bak-*
ver_*.js
apply_*.js
generar_*.sh
